{
  "name": "ai-code-reviewer",
  "version": "2.0.0",
  "description": "An AI-powered code reviewer with structured outputs, multi-provider support (GitHub / Azure DevOps / local git), concurrent multi-pass review pipeline, caching, and a modern interactive HTML report.",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "ai-review": "./bin/review.js"
  },
  "scripts": {
    "review": "node bin/review.js",
    "review:local": "node bin/review.js local",
    "review:github": "node bin/review.js github",
    "review:azure": "node bin/review.js azure",
    "test": "node tests/run.js"
  },
  "keywords": [
    "ai",
    "code-review",
    "openai",
    "azure-openai",
    "github",
    "azure-devops",
    "static-analysis",
    "developer-tools",
    "ci"
  ],
  "engines": {
    "node": ">=18"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@octokit/rest": "^21.0.2",
    "azure-devops-node-api": "^15.1.0",
    "chalk": "^5.3.0",
    "diff": "^8.0.2",
    "dotenv": "^16.4.5",
    "ora": "^8.1.0",
    "openai": "^5.8.3",
    "p-limit": "^6.1.0",
    "yargs": "^17.7.2"
  }
}
